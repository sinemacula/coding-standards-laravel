# Run by `composer analyse` in CI, not through qlty, which never installs the
# vendor and so cannot see PHP_CodeSniffer's source.
parameters:
    # Matches the level qlty passes everywhere else.
    level: 9

    # PHP_CodeSniffer classes are not on the Composer classmap.
    scanDirectories:
        - vendor/squizlabs/php_codesniffer/src

    paths:
        - src
        - SineMaculaLaravel/Sniffs
        - SineMaculaLaravel/Tests

    ignoreErrors:
        # PHP_CodeSniffer exposes token data as mixed.
        - identifier: offsetAccess.invalidOffset
        - identifier: binaryOp.invalid
        - identifier: assignOp.invalid
        - identifier: postInc.type
        - identifier: foreach.nonIterable

        # parseConstraints() throws UnexpectedValueException without declaring it.
        -
            identifier: catch.neverThrown
            path: src/PHPStan/Concerns/DetectsLaravelVersion.php
