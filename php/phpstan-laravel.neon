# Laravel layer on top of the base standard's php/phpstan.neon. No level: the
# runner passes --level=9 on the command line, which overrides any config value.
parameters:
    sineMaculaLaravel:
        # Laravel 13.2 attributes; `modelAttributes!:` replaces the set.
        modelAttributes:
            - Table
            - Fillable
            - Hidden

        # Leave empty to detect the floor from the nearest composer.json.
        minLaravelVersion: ''

        # Append under `modelHooks:` with the reason; `modelHooks!:` replaces.
        modelHooks:
            - uniqueIds
            - newUniqueId
            - getRouteKeyName
            - resolveRouteBindingQuery
            - getMorphClass
            - prunable
            - getTable
            - getConnectionName

    # Pins the column scan to the project; unset, it resolves from the booted
    # application, which an isolated runner can boot elsewhere.
    databaseMigrationsPath:
        - %currentWorkingDirectory%/database/migrations

    # Reads cast types from the body of casts(); unset, they come from its
    # declared array<string, string> return type and every cast is lost.
    parseModelCastsMethod: true

    # Methods forwarded onto a builder are reflected as static, so ordinary
    # query code reads as a dynamic call to a static method.
    ignoreErrors:
        -
            identifier: staticMethod.dynamicCall
            message: '#^Dynamic call to static method Illuminate\\Database\\(Eloquent|Query)\\Builder#'

    # The handler renders a validation failure as a 422, and a binding failure is
    # a container misconfiguration, so a @throws for either is noise.
    exceptions:
        uncheckedExceptionClasses:
            - Illuminate\Contracts\Container\BindingResolutionException
            - Illuminate\Validation\ValidationException

parametersSchema:
    # Set above but owned by the Laravel extension; an undeclared one is rejected.
    databaseMigrationsPath: listOf(string())
    parseModelCastsMethod: bool()

    sineMaculaLaravel: structure([
        modelAttributes: listOf(string())
        minLaravelVersion: string()
        modelHooks: listOf(string())
    ])

rules:
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\DisallowCastsPropertyRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\DisallowDatesPropertyRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\DisallowFactoryTimestampsRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireFillableCastsRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireForeignIdForRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireFormRequestRulesRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireMassAssignmentDeclarationRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireMigrationMethodsRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireRelationshipReturnTypeRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireSnakeCaseResourceFieldsRule
    - SineMacula\CodingStandardsLaravel\PHPStan\Rules\RequireSnakeCaseSchemaRule

# Registered as services so the parameters above can be injected.
services:
    -
        class: SineMacula\CodingStandardsLaravel\PHPStan\Rules\DisallowModelBehaviourRule
        arguments:
            hooks: %sineMaculaLaravel.modelHooks%
        tags:
            - phpstan.rules.rule
    -
        class: SineMacula\CodingStandardsLaravel\PHPStan\Rules\PreferModelAttributesRule
        arguments:
            attributes: %sineMaculaLaravel.modelAttributes%
            minLaravelVersion: %sineMaculaLaravel.minLaravelVersion%
        tags:
            - phpstan.rules.rule
    -
        class: SineMacula\CodingStandardsLaravel\PHPStan\Rules\PreferQueueAttributesRule
        arguments:
            minLaravelVersion: %sineMaculaLaravel.minLaravelVersion%
        tags:
            - phpstan.rules.rule
