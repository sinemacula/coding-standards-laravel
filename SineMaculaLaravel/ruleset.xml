<?xml version="1.0"?>
<ruleset name="SineMaculaLaravel">

    <description>Sine Macula coding standard for Laravel projects.</description>

    <!--
        Pull in the full framework-agnostic SineMacula standard so a Laravel project
        references a single standard (`SineMaculaLaravel`) and gets both layers. The
        sinemacula/coding-standards package must be installed alongside this one.

        The Slevomat native/any type-hint requirements are dropped here and replaced
        by the Laravel-aware SineMaculaLaravel.TypeHints sniffs below: those Slevomat
        sniffs are inheritance-blind, so they force types onto members that override
        an untyped framework declaration ($table, #[\Override] methods, …), which
        fatals at class load. The traversable-specification checks (which require
        `@param array<int, Foo>` and never fatal) are kept.
    -->
    <rule ref="SineMacula">
        <exclude name="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingNativeTypeHint"/>
        <exclude name="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingAnyTypeHint"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingNativeTypeHint"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingAnyTypeHint"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingNativeTypeHint"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingAnyTypeHint"/>
    </rule>

    <!--
        A Blade template holds no PHP to check, so every one reports NoCodeFound.
        Only that report is dropped: the template is still read for its location.
    -->
    <rule ref="Internal.NoCodeFound">
        <exclude-pattern>*.blade.php</exclude-pattern>
    </rule>

    <!--
        Exempt the framework bases that declare public magic properties from the
        readonly-public-property requirement. A subclass overrides them ($timestamps
        and $incrementing on a model, $collects on a resource collection,
        $withinTransaction on a migration, …), and they are declared non-readonly on
        the base class - PHP forbids making an inherited property readonly, so the
        requirement cannot be satisfied. The base sniff matches the immediate parent
        name as written, so the bases are listed by short name.

        A queued class or broadcast event is exempt only for the properties the
        framework reads off it, which need a default and so cannot be readonly.
    -->
    <rule ref="SineMacula.Classes.RequireReadonlyPublicProperty">
        <properties>
            <property name="ignoredParentClasses" type="array">
                <element value="Model"/>
                <element value="Authenticatable"/>
                <element value="Pivot"/>
                <element value="Migration"/>
                <element value="JsonResource"/>
                <element value="ResourceCollection"/>
            </property>
            <property name="ignoredInterfaceProperties" type="array">
                <element key="ShouldQueue" value="tries,timeout,backoff,maxExceptions,failOnTimeout,deleteWhenMissingModels,uniqueFor,uniqueId,debounceFor,shouldBeEncrypted,afterCommit,connection,queue,delay"/>
                <element key="ShouldQueueAfterCommit" value="tries,timeout,backoff,maxExceptions,failOnTimeout,deleteWhenMissingModels,uniqueFor,uniqueId,debounceFor,shouldBeEncrypted,afterCommit,connection,queue,delay"/>
                <element key="ShouldBroadcast" value="tries,timeout,backoff,maxExceptions,deleteWhenMissingModels,afterCommit,uniqueFor,uniqueId,connection,queue,broadcastQueue"/>
            </property>
        </properties>
    </rule>

    <!--
        A policy's ability methods are named for the abilities the Gate checks
        (viewAny, update, before, ...), so they cannot take a predicate prefix.
    -->
    <rule ref="SineMacula.NamingConventions.BooleanMethodName">
        <properties>
            <property name="ignoredClassSuffixes" type="array">
                <element value="Policy"/>
            </property>
        </properties>
    </rule>

    <!--
        Laravel-specific sniffs live in this standard's Sniffs/ directory and are
        auto-discovered by PHP_CodeSniffer - no <rule ref> lines are needed for them.
    -->

</ruleset>
